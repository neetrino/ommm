{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm exec next dev -p 3000",
    "build": "pnpm -w run build:database && pnpm exec next build",
    "start": "pnpm exec next start -p 3000",
    "lint": "pnpm exec eslint",
    "test:unit": "pnpm exec tsx --test src/lib/backoffice-capabilities.test.ts src/lib/dashboard-nav.test.ts src/lib/role-home.test.ts src/components/marketing/home/get-default-weekly-schedule-day.test.ts",
    "test:e2e": "pnpm exec playwright test",
    "assets:hero-logo-mark-pingpong": "node scripts/build-home-hero-logo-mark-pingpong.mjs",
    "assets:upload-marketing-videos": "node scripts/upload-marketing-videos-to-r2.mjs"
  },
  "dependencies": {
    "@ommm/database": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "next": "16.2.6",
    "next-intl": "^4.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "ffmpeg-static": "^5.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
