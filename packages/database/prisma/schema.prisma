generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  COACH
  MANAGER
  CONTENT_ADMIN
  ADMIN
}

enum ClassSessionStatus {
  DRAFT
  ACTIVE
  FULL
  CANCELLED
}

enum BookingStatus {
  BOOKED
  COMPLETED
  CANCELLED
  MISSED
}

enum BookingChannel {
  WEBSITE
  APP
}

enum WaitlistStatus {
  ACTIVE
  OFFERED
  EXPIRED
  CONVERTED
  REMOVED
}

enum ContentType {
  EVENT
  BLOG
  NEWS
  UPDATE
  KNOWLEDGE_ARTICLE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  PUBLISHED
  HIDDEN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentSource {
  PACKAGE
  DROPIN
  GIFT
  OTHER
}

enum PackageStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  /** Awaiting manual / offline payment confirmation by admin. */
  PENDING
}

enum ManualPaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  DEACTIVATED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ScheduleDayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum SessionRecurrencePattern {
  NONE
  DAILY
  WEEKLY
  CUSTOM_WEEKDAYS
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  phone          String?   @unique
  name           String?
  lastName       String?
  dateOfBirth    DateTime?
  avatarUrl      String?
  /** Full public HTTPS URL (e.g. Cloudflare R2) or legacy `/v1/uploads/...` path when storing locally. */
  homeImageUrl   String?
  role           Role      @default(USER)
  /** When true, the member cannot sign in or book until unblocked by admin. */
  isBlocked      Boolean   @default(false)
  emailVerified  DateTime?
  /** Preferred UI locale for this user only (`hy` | `en` | `ru`). Updated via PATCH /users/me and language switcher. */
  locale           String    @default("hy")
  giftCreditsCents Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  coachProfile      CoachProfile?
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  payments          Payment[]
  userPackages      UserPackage[]
  giftCardsPurchased GiftCard[] @relation("GiftCardPurchaser")
  giftCardsReceived  GiftCard[] @relation("GiftCardRecipient")
  giftCardBatchesCreated GiftCardBatch[] @relation("GiftCardBatchPurchaser")
  giftCardBatchesReceived GiftCardBatch[] @relation("GiftCardBatchRecipient")
  achievements      UserAchievement[]
  notificationPrefs NotificationPreference?
  bookingNotesAuthored BookingNote[] @relation("BookingNoteAuthor")
  clientNotesAuthored  ClientNote[]  @relation("ClientNoteAuthor")
  clientNotesReceived  ClientNote[]  @relation("ClientNoteSubject")
  authTokens         AuthToken[]
  oauthAccounts      OAuthAccount[]
  pushDeviceTokens   PushDeviceToken[]
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model OAuthAccount {
  id                    String   @id @default(cuid())
  userId                String
  provider              String
  providerAccountId     String
  providerEmail         String?
  providerEmailVerified Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PushDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model CoachProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  specialization String?
  classType      String?
  assignedClassTypeIds String[] @default([])
  experienceYears Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions            ClassSession[] @relation("SessionCoach")
  substituteSessions  ClassSession[] @relation("SessionSubstituteCoach")
  availabilitySlots   CoachAvailabilitySlot[]
}

model CoachAvailabilitySlot {
  id              String       @id @default(cuid())
  coachProfileId  String
  coachProfile    CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  slotDate        DateTime
  slotTime        String
  availableSpots  Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([coachProfileId, slotDate, slotTime])
}

model ClassType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions        ClassSession[]
}

model ClassSession {
  id                 String             @id @default(cuid())
  title              String             @default("")
  description        String?
  classTypeId        String
  classType          ClassType          @relation(fields: [classTypeId], references: [id])
  coachId            String
  coach              CoachProfile       @relation("SessionCoach", fields: [coachId], references: [id])
  substituteCoachId  String?
  substituteCoach    CoachProfile?      @relation("SessionSubstituteCoach", fields: [substituteCoachId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  level              String?
  classFormat        String?
  priceCents         Int                @default(0)
  sessionRequirement Int?
  status             ClassSessionStatus @default(ACTIVE)
  recurrencePattern  SessionRecurrencePattern @default(NONE)
  recurrenceWeekdays ScheduleDayOfWeek[] @default([])
  recurrenceEndsAt   DateTime?
  recurrenceCount    Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userPackageId String?
  userPackage   UserPackage?  @relation(fields: [userPackageId], references: [id], onDelete: SetNull)
  status        BookingStatus @default(BOOKED)
  channel       BookingChannel @default(WEBSITE)
  attendedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  notes BookingNote[]
  reminderLog ClassReminderSendLog?

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@index([userId])
  @@index([userPackageId])
  @@index([status, createdAt])
}

model BookingNote {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("BookingNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ClientNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("ClientNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ClientNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String
  session        ClassSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position       Int
  status         WaitlistStatus @default(ACTIVE)
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, sessionId])
  @@index([sessionId])
}

model PackagePlan {
  id               String   @id @default(cuid())
  name             String
  categoryName     String   @default("General")
  slug             String   @unique
  description      String?
  priceCents       Int
  currency         String   @default("USD")
  sessionsPerMonth Int?
  isUnlimited      Boolean  @default(false)
  periodDays       Int      @default(30)
  billingPeriod    String   @default("monthly")
  features         String[] @default([])
  buttonLabel      String   @default("Choose plan")
  isPopular        Boolean  @default(false)
  displayOrder     Int      @default(0)
  guestCount       Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userPackages UserPackage[]
  payments     Payment[]
}

model UserPackage {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 PackagePlan   @relation(fields: [planId], references: [id])
  status               PackageStatus @default(ACTIVE)
  /** Total sessions included in the current billing period (null when unlimited). */
  sessionsTotal        Int?
  sessionsRemaining    Int?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  pausedUntil          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  pendingPayment       Payment?
  bookings             Booking[]

  @@index([userId])
}

model Payment {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  currency        String               @default("amd")
  status          PaymentStatus        @default(PENDING)
  paymentReference String?             @unique
  source          PaymentSource        @default(OTHER)
  sourceId        String?
  description     String?
  metadata        Json?
  confirmedAt     DateTime?
  confirmedByAdminId String?
  planId          String?
  plan            PackagePlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  paymentMethod   ManualPaymentMethod?
  userPackageId   String?              @unique
  userPackage     UserPackage?         @relation(fields: [userPackageId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([planId, status])
  @@index([source, sourceId])
}

model GiftCard {
  id              String         @id @default(cuid())
  batchId         String?
  batch           GiftCardBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  code            String         @unique
  amountAmd       Int            @map("amountCents")
  balanceAmd      Int            @map("balanceCents")
  imageUrl        String?
  status          GiftCardStatus @default(ACTIVE)
  purchaserId     String
  purchaser       User           @relation("GiftCardPurchaser", fields: [purchaserId], references: [id])
  recipientId     String?
  recipient       User?          @relation("GiftCardRecipient", fields: [recipientId], references: [id])
  recipientEmail  String?
  recipientName   String?
  message         String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([batchId])
}

model GiftCardBatch {
  id                String         @id @default(cuid())
  amountAmd         Int            @map("amountCents")
  imageUrl          String?
  status            GiftCardStatus @default(ACTIVE)
  totalQuantity     Int
  availableQuantity Int
  purchaserId       String
  purchaser         User           @relation("GiftCardBatchPurchaser", fields: [purchaserId], references: [id], onDelete: Restrict)
  recipientId       String?
  recipient         User?          @relation("GiftCardBatchRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  recipientEmail    String?
  recipientName     String?
  message           String?
  expiresAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  giftCards GiftCard[]

  @@index([status, createdAt])
  @@index([purchaserId])
  @@index([recipientId])
}

model ContentPost {
  id             String        @id @default(cuid())
  type           ContentType
  status         ContentStatus @default(DRAFT)
  slug           String        @unique
  title          String
  excerpt        String?
  body           String?
  authorName     String?
  tags           String[]      @default([])
  seoTitle       String?
  seoDescription String?
  editorialNotes String?
  reviewNotes    String?
  reviewedById   String?
  reviewedAt     DateTime?
  submittedForReviewAt DateTime?
  coverImageUrl String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  translations ContentPostTranslation[]

  @@index([type, status])
}

model ContentPostTranslation {
  id             String   @id @default(cuid())
  postId         String
  locale         String
  slug           String
  title          String   @default("")
  excerpt        String?
  body           String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@index([postId])
}

model StudioSettings {
  id                      String   @id @default(cuid())
  studioName              String   @default("Ommm")
  contactEmail            String?
  contactPhone            String?
  whatsappUrl             String?
  address                 String?
  mapEmbedUrl             String?
  workingHours            String?
  socialLinksJson         String?
  cancellationHoursNotice Int      @default(24)
  waitlistOfferMinutes    Int      @default(30)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ScheduleItem {
  id              String            @id @default(cuid())
  className       String
  instructorName  String
  classType       String
  dayOfWeek       ScheduleDayOfWeek
  startTime       String
  endTime         String?
  durationMinutes Int?
  availableSpots  Int
  description     String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isActive, dayOfWeek, startTime])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  threshold   Int
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model NotificationPreference {
  userId              String  @id
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingReminders    Boolean @default(true)
  waitlistAlerts      Boolean @default(true)
  promotions          Boolean @default(false)
  communityUpdates    Boolean @default(true)
}

model ClassReminderSendLog {
  id        String   @id @default(cuid())
  bookingId String   @unique
  sentAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  payload    String?
  createdAt  DateTime @default(now())
}
