/**
 * Shared booking-activity inbox (header bell).
 * Admin/Manager see the studio feed (`staffReadAt`).
 * Coaches see only their class rows (`coachProfileId` + `coachReadAt`).
 * Denormalized display fields survive booking deletion.
 */
model StaffActivityNotification {
  id              String            @id @default(cuid())
  type            StaffActivityType
  bookingId       String?
  booking         Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  memberUserId    String?
  member          User?             @relation("StaffActivityMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  memberName      String
  className       String
  sessionStartsAt DateTime
  createdAt       DateTime          @default(now())
  staffReadAt     DateTime?
  /// Class coach — coaches see only their rows; independent of studio staffReadAt.
  coachProfileId  String?
  coachProfile    CoachProfile?     @relation(fields: [coachProfileId], references: [id], onDelete: SetNull)
  coachReadAt     DateTime?

  @@index([createdAt])
  @@index([staffReadAt, createdAt])
  @@index([type, createdAt])
  @@index([bookingId])
  @@index([memberUserId])
  @@index([coachProfileId, coachReadAt, createdAt])
}
