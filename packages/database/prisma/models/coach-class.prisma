model CoachProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  specialization String?
  classType      String?
  assignedClassTypeIds String[] @default([])
  experienceYears Int?
  /// Whole AMD paid to the coach for one completed class with participants.
  salaryPerClassAmd Int @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions            ClassSession[] @relation("SessionCoach")
  substituteSessions  ClassSession[] @relation("SessionSubstituteCoach")
  availabilitySlots   CoachAvailabilitySlot[]
  sessionReviews      SessionReview[]
  salaryAccruals      CoachSalaryAccrual[]
  salaryPayouts       CoachSalaryPayout[]
  staffActivityNotifications StaffActivityNotification[]
}

model CoachAvailabilitySlot {
  id              String       @id @default(cuid())
  coachProfileId  String
  coachProfile    CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  slotDate        DateTime
  slotTime        String
  availableSpots  Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([coachProfileId, slotDate, slotTime])
}

/// Canonical catalog of schedulable class kinds. Admin schedule sessions must reference this table only.
model ClassType {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  /// Soft-delete: hidden from catalog UI; row and id remain for sessions, bookings, balances.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions             ClassSession[]
  packagePlans         PackagePlan[]
  userPackageBalances  UserPackageBalance[]
}

model ClassSession {
  id                 String             @id @default(cuid())
  title              String             @default("")
  description        String?
  /// FK to ClassType only — not package categories or free text.
  classTypeId        String
  classType          ClassType          @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  coachId            String
  coach              CoachProfile       @relation("SessionCoach", fields: [coachId], references: [id])
  substituteCoachId  String?
  substituteCoach    CoachProfile?      @relation("SessionSubstituteCoach", fields: [substituteCoachId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  level              String?
  classFormat        String?
  priceCents         Int                @default(0)
  sessionRequirement Int?
  status             ClassSessionStatus @default(ACTIVE)
  recurrencePattern  SessionRecurrencePattern @default(NONE)
  recurrenceWeekdays ScheduleDayOfWeek[] @default([])
  recurrenceEndsAt   DateTime?
  recurrenceCount    Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  sessionReviews  SessionReview[]
  salaryAccrual   CoachSalaryAccrual?

  @@index([status, startsAt])
}

/// One salary line per completed class with at least one real participant.
model CoachSalaryAccrual {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  classSessionId String       @unique
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  /// Snapshot of salaryPerClassAmd at generation time (whole AMD).
  amountAmd      Int
  periodYear     Int
  periodMonth    Int
  createdAt      DateTime     @default(now())

  @@index([coachProfileId, periodYear, periodMonth])
}

/// Admin payment of a coach's unpaid salary for a calendar month.
model CoachSalaryPayout {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  amountAmd      Int
  periodYear     Int
  periodMonth    Int
  paidAt         DateTime     @default(now())
  paidByAdminId  String
  paidByAdmin    User         @relation("CoachSalaryPayoutAdmin", fields: [paidByAdminId], references: [id], onDelete: Restrict)

  @@index([coachProfileId, periodYear, periodMonth])
  @@index([paidByAdminId])
}
