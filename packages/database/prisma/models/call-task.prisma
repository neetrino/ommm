model CallTask {
  id           String         @id @default(cuid())
  contactName  String
  phone        String
  comment      String
  dueOn        DateTime
  status       CallTaskStatus @default(PENDING)
  userId       String?
  user         User?          @relation("CallTaskClient", fields: [userId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User           @relation("CallTaskAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, dueOn])
  @@index([createdById])
  @@index([userId])
}
