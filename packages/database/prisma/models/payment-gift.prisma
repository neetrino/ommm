model Payment {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  currency        String               @default("amd")
  status          PaymentStatus        @default(PENDING)
  paymentReference String?             @unique
  source          PaymentSource        @default(OTHER)
  sourceId        String?
  description     String?
  metadata        Json?
  confirmedAt     DateTime?
  successEmailSentAt DateTime?
  cashPendingEmailSentAt DateTime?
  confirmedByAdminId String?
  paymentMethod   ManualPaymentMethod?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  ehdmReceipt     EhdmReceipt?

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([source, sourceId])
}

model GiftCard {
  id              String         @id @default(cuid())
  batchId         String?
  batch           GiftCardBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  code            String         @unique
  type            GiftCardType   @default(FIXED_VALUE)
  amountAmd       Int            @map("amountCents")
  balanceAmd      Int            @map("balanceCents")
  classTypeId     String?
  classType       ClassType?     @relation(fields: [classTypeId], references: [id], onDelete: SetNull)
  classQuantity   Int            @default(0)
  balanceClasses  Int            @default(0)
  allowOtherClasses Boolean      @default(false)
  imageUrl        String?
  status          GiftCardStatus @default(ACTIVE)
  redeemedAt      DateTime?
  purchaserId     String?
  purchaser       User?          @relation("GiftCardPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  recipientId     String?
  recipient       User?          @relation("GiftCardRecipient", fields: [recipientId], references: [id])
  recipientEmail  String?
  recipientName   String?
  message         String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  transactions    GiftCardTransaction[]

  @@index([batchId])
  @@index([recipientId, status])
  @@index([classTypeId])
}

model GiftCardBatch {
  id                String         @id @default(cuid())
  type              GiftCardType   @default(FIXED_VALUE)
  amountAmd         Int            @map("amountCents")
  classTypeId       String?
  classType         ClassType?     @relation(fields: [classTypeId], references: [id], onDelete: SetNull)
  classQuantity     Int            @default(0)
  imageUrl          String?
  status            GiftCardStatus @default(ACTIVE)
  totalQuantity     Int
  availableQuantity Int
  purchaserId       String?
  purchaser         User?          @relation("GiftCardBatchPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  recipientId       String?
  recipient         User?          @relation("GiftCardBatchRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  recipientEmail    String?
  recipientName     String?
  message           String?
  expiresAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  giftCards GiftCard[]

  @@index([status, createdAt])
  @@index([purchaserId])
  @@index([recipientId])
  @@index([classTypeId])
}

/// One row per issue, activation, spend, refund, adjustment, or expiry.
model GiftCardTransaction {
  id                  String                   @id @default(cuid())
  giftCardId          String
  giftCard            GiftCard                 @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  kind                GiftCardTransactionKind
  userId              String?
  orderId             String?
  amountAmd           Int                      @default(0) @map("amountCents")
  classes             Int                      @default(0)
  balanceAmdAfter     Int                      @map("balanceCentsAfter")
  balanceClassesAfter Int                      @default(0)
  createdAt           DateTime                 @default(now())

  @@index([giftCardId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
}
