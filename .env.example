# Single monorepo `.env` at the repo root (copy to `.env`, never commit secrets).
# Loaded by: Next (`apps/web`), Nest (`apps/api`, see `envFilePath`), Expo (`apps/mobile/app.config.ts` loads this file + optional root `.env.local`).
# Optional overrides: `apps/web/.env.local`, `apps/api/.env` (Nest precedence).

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
WEB_APP_URL="http://localhost:3000"
# Optional comma-separated extra browser origins for Nest CORS (e.g. Expo web on LAN: http://192.168.1.10:8081)
# CORS_ORIGINS=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Browser SSE only — direct Nest origin (same value as NEXT_PUBLIC_API_URL in most setups)
NEXT_PUBLIC_API_ORIGIN="http://localhost:4000"
# Expo (client bundle — use EXPO_PUBLIC_* only for mobile; no secrets).
# In development, `apps/mobile` can auto-pick the API host when this is unset (see `src/lib/api/config.ts`).
# When set: Android emulator → `http://10.0.2.2:4000` (Nest must listen on 0.0.0.0 — default in `apps/api`).
# Physical phone: `http://<your-PC-LAN-IP>:4000`. iOS Simulator / Expo Web: `http://localhost:4000` (or leave unset in dev).
# If `10.0.2.2` times out on the emulator: allow TCP 4000 in Windows Firewall, or `adb reverse tcp:4000 tcp:4000` and use `http://127.0.0.1:4000`.
# Production mobile builds must set this explicitly.
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"
# Next rewrites: server-side proxy to Nest (`apps/web/next.config.ts`)
API_INTERNAL_URL="http://127.0.0.1:4000"
# Nest HTTP port (local dev). Prefer API_PORT so root PORT is free for hosting/Next.
API_PORT="4000"
# Platform hosting fallback for Nest when API_PORT is unset (e.g. Render). Do not set locally for Web.
# PORT="4000"
# Bind address for Nest (default 0.0.0.0 — needed for Android emulator / LAN). Example: 127.0.0.1 for localhost-only.
# API_LISTEN_HOST="0.0.0.0"

# Database Configuration
# Neon: pooled URL for the app; direct (non-pooler) for migrations / Prisma `directUrl`
DATABASE_URL=""
DIRECT_URL=""
# Prod: production database url
DIRECT_PROD_URL=""

DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"
# Disconnect Prisma after idle so Neon can scale-to-zero (default on; set false to disable).
# PRISMA_IDLE_DISCONNECT="true"
# Idle window before $disconnect (ms). Default 240000 (4 min) — under Neon’s 5 min sleep.
# PRISMA_IDLE_DISCONNECT_MS="240000"

# Nest background jobs: one batch at :00 and :30 (Render process env).
# CRON_BATCH_SCHEDULE="0,30 * * * *"


# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_SEC="604800"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the web app origin + Next `/api/v1` proxy path (not raw Nest port in dev).
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Expo Push (optional — Nest → Expo Push API for class reminders alongside email)
# EXPO_ACCESS_TOKEN=""
# EXPO_PUBLIC_EAS_PROJECT_ID=""


# ——— Cache (Upstash Redis) ———
# Public marketing reads (schedule, coaches, plans, content) are cached in Redis with TTL.
# Set both on Render (Nest API). Without these, the API falls back to direct DB reads.
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN=""

# Vercel Cron: pings Render `/v1/health` every ~14 min (no DB). Set on Vercel only.
# CRON_SECRET=""
# Vercel Web Analytics (`apps/web`). Enable in Vercel project → Analytics. Set to "false" to disable.
# NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED="true"


# ——— Email ———
# `log` / `test` = only log to Nest console (no Resend). Default when NODE_ENV is not production.
# `resend` = send via Resend (needs valid RESEND_API_KEY). Default when NODE_ENV=production.
# MAIL_TRANSPORT="log"
# MAIL_TRANSPORT="resend"
# MAIL_TRANSPORT="nodemailer"
# ——— Resend (only when MAIL_TRANSPORT=resend) ———
RESEND_API_KEY=""
RESEND_FROM_EMAIL="test@neetrino.com"
RESEND_FROM="Ommm <onboarding@resend.dev>"
# Admin/studio inbox for contact form submissions and payment success notifications.
# Falls back to Studio settings → contact email when empty.
CONTACT_RECEIVER_EMAIL=""

# ——— File storage (Cloudflare R2) — Home banner uploads use S3 API when these are set; otherwise the API falls back to local disk under `/v1/uploads/`.
# Account ID builds default endpoint `https://<id>.r2.cloudflarestorage.com` if R2_S3_ENDPOINT is empty.
R2_ACCOUNT_ID=""
# S3-compatible API URL (optional if R2_ACCOUNT_ID is set)
R2_S3_ENDPOINT=""
# R2_API_TOKEN is for Cloudflare REST API (Workers). Home image upload uses R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY only.
R2_API_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public bucket URL (e.g. *.r2.dev or custom domain), no trailing slash
R2_PUBLIC_URL=""
# Marketing hero videos are served from R2 (`R2_PUBLIC_URL` + keys in `home-hero-banner-tokens.ts`).
# Upload local sources: `pnpm --filter web assets:upload-marketing-videos`
# Sources live in `apps/web/assets/marketing/home/hero/` (not bundled by Next).
# Set to true to forbid local-disk fallback for home images (upload fails until R2 env is valid).
# R2_HOME_IMAGE_REQUIRED="false"

# ——— Arca / iPay (EPG — epg.arca.am / testepg.arca.am) ———
# REST API only: *_api user (NOT _web). Password = portal-ից _api-ի գաղտնաբառը։
# Test: ARCA_API_BASE_URL="https://testepg.arca.am"
# Live: ARCA_API_BASE_URL="https://epg.arca.am"
ARCA_API_BASE_URL=""
ARCA_API_USERNAME=""
ARCA_API_PASSWORD=""
ARCA_BANK="epg"
ARCA_CURRENCY_CODE="051"
ARCA_LANGUAGE="en"
ARCA_FORCE_3DS2="true"
# Card checkout: "false" = in-app fake pay (default); "true" = redirect to Arca bank page.
ARCA_CHECKOUT_ENABLED="false"
NEXT_PUBLIC_ARCA_CHECKOUT_ENABLED="false"
EXPO_PUBLIC_ARCA_CHECKOUT_ENABLED="false"

# ——— EHDM / E-HDM (Armenia fiscal receipts) ———
# Defaults live in `apps/api/src/payments/ehdm/ehdm.constants.ts`.
# With no EHDM vars set, the API uses mock receipts (no PEC certificate required).
# Live production — set all of:
EHDM_API_URL="https://ecrm.taxservice.am/taxsystem-rs-vcr/api/v1.0"
EHDM_CRN=""
EHDM_TIN=""
# PEM client cert + encrypted PKCS#8 key, each value = base64 of the PEM file (not the raw PEM text).
EHDM_CERT_BASE64=""
EHDM_KEY_BASE64=""
EHDM_KEY_PASSPHRASE=""
EHDM_DEFAULT_ADG_CODE=""
EHDM_DEP="3"
EHDM_DEFAULT_UNIT="Հատ"
EHDM_CASHIER_ID="1"
EHDM_SHIPPING_ENABLED="0"

